# Tripletex API
TRIPLETEX_CONSUMER_TOKEN=your-consumer-token
TRIPLETEX_EMPLOYEE_TOKEN=your-employee-token
TRIPLETEX_ENV=test  # test | prod

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Notion (read-only)
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_API_KEY=your-notion-api-key

# LLM (Renvasken Layer 3)
ANTHROPIC_API_KEY=your-anthropic-key

# Safety
PROD_CONFIRM=false  # Must be explicitly set to "true" for production writes
